# Public (exposed to the browser). Safe to ship.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-payment-link-here
NEXT_PUBLIC_VSL_EMBED_URL=

# Dashboard · The Room island.
# URL the "Open the room" button links to (Discord, Circle, Whop, Skool, etc).
NEXT_PUBLIC_COMMUNITY_URL=
# Human-readable date of the next live Q&A. Shown inside the island.
# Example: "May 15, 7pm ET"
NEXT_PUBLIC_NEXT_QA_DATE=

# Server-only. Never exposed to the client.
# Shared password for /dashboard access. All buyers get the same one.
# Rotate by changing this value and sending new welcome emails.
ACCESS_PASSWORD=change-me
